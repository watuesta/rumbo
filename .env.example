# Variables del stack. En Portainer se cargan en Stacks > rumbo > Environment variables.
# Para desarrollo local, copia este archivo a .env. Nunca subas .env al repositorio.

# Django
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
# Cambia rumbo.ejemplo.com por tu dominio.
ALLOWED_HOSTS=rumbo.ejemplo.com
CSRF_TRUSTED_ORIGINS=https://rumbo.ejemplo.com

# PostgreSQL
POSTGRES_DB=rumbo
POSTGRES_USER=rumbo
POSTGRES_PASSWORD=
